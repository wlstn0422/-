<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: #fbfaf7; --surface: #ffffff; --text: #1d1f23; --muted: #5d636e; --line: #e4e1da;
  --accent: #1f5f8b; --accent-soft: #e8f0f6; --warn-bg: #fff6e0; --warn-line: #e8c46a; --code: #f2f0eb;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #15171b; --surface: #1c1f24; --text: #e6e6e3; --muted: #a2a7b0; --line: #2e3238;
    --accent: #7db7e0; --accent-soft: #1f2c37; --warn-bg: #2d2717; --warn-line: #8a7230; --code: #24282e;
  }
}
:root[data-theme="dark"] {
  --bg: #15171b; --surface: #1c1f24; --text: #e6e6e3; --muted: #a2a7b0; --line: #2e3238;
  --accent: #7db7e0; --accent-soft: #1f2c37; --warn-bg: #2d2717; --warn-line: #8a7230; --code: #24282e;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: "Pretendard", -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
  font-size: 16px; line-height: 1.7; word-break: keep-all; overflow-wrap: anywhere;
}
header.top { border-bottom: 1px solid var(--line); background: var(--surface); }
header.top .wrap { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; padding-top: 12px; padding-bottom: 12px; }
header.top a { color: var(--text); text-decoration: none; font-weight: 600; }
header.top nav a { font-weight: 500; color: var(--muted); margin-right: 14px; }
.wrap { max-width: 880px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
main { padding-top: 8px; padding-bottom: 64px; }
h1 { font-size: 1.6rem; line-height: 1.35; margin: 28px 0 8px; }
h2 { font-size: 1.25rem; margin: 40px 0 12px; padding-top: 12px; border-top: 2px solid var(--line); }
h3 { font-size: 1.08rem; margin: 28px 0 8px; }
p, ul, ol { margin: 8px 0 12px; }
a { color: var(--accent); }
blockquote { margin: 12px 0; padding: 10px 14px; background: var(--warn-bg); border-left: 3px solid var(--warn-line); border-radius: 4px; }
blockquote p { margin: 4px 0; }
.table-wrap { overflow-x: auto; margin: 10px 0 16px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
th, td { padding: 7px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
th { background: var(--accent-soft); font-weight: 600; white-space: nowrap; }
tr:last-child td { border-bottom: none; }
details { margin: 8px 0 16px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
summary { cursor: pointer; color: var(--accent); font-weight: 600; }
code { background: var(--code); padding: 1px 5px; border-radius: 4px; font-size: 0.9em; }
hr { border: none; border-top: 1px solid var(--line); margin: 32px 0 16px; }
footer { color: var(--muted); font-size: 0.85rem; }
.brief { background: var(--accent-soft); border-radius: 10px; padding: 4px 16px 4px 12px; margin: 8px 0 12px; }
.brief ol { padding-left: 22px; margin: 10px 0; }
.brief li { margin: 8px 0; }
.jump { color: var(--muted); font-size: 0.88rem; }
.jump p { margin: 4px 0 8px; }
.off { color: var(--muted); opacity: 0.6; }
@media (max-width: 600px) { body { font-size: 15px; } h1 { font-size: 1.35rem; } th, td { padding: 6px 8px; } }
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <a href="{{ root }}today.html">{{ site_title }}</a>
  <nav><a href="{{ root }}today.html">오늘의 노트</a><a href="{{ root }}calendar.html">캘린더</a>{% if has_scale %}<a href="{{ root }}scale.html">규모 지도</a>{% endif %}</nav>
</div></header>
<main class="wrap">
{{ body }}
</main>
</body>
</html>
